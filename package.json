{
  "name": "sweet-kit",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=server --filter=web",
    "zod:check": "node rules/zod-v4/check.js",
    "ui:check": "node scripts/ui-guardrails.js",
    "design:check": "oxlint",
    "rules:check": "pnpm zod:check && pnpm ui:check && pnpm design:check",
    "infra:up": "docker compose up -d --wait postgres",
    "infra:down": "docker compose down",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo build --filter=server... && vitest run",
    "verify": "pnpm lint && pnpm rules:check && pnpm typecheck && pnpm test && pnpm build && pnpm knip && pnpm peers check",
    "db:generate": "pnpm --filter server auth:generate && pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@shadcn/lint": "^0.2.1",
    "@workspace/typescript-config": "workspace:*",
    "knip": "^6.42.0",
    "lefthook": "^2.2.2",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24"
  }
}
